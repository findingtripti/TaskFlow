# ============================================================
# TaskFlow – Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to source control.
# ============================================================

# Server
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/taskflow
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/taskflow
MONGODB_URI=mongodb://localhost:27017/taskflow

# JWT secret key (use a long, random, unpredictable string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Node environment
NODE_ENV=development
